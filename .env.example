# Base URL for the local Ollama instance (used in local development)
OLLAMA_BASE_URL=http://localhost:11434

# Vision model used for bird identification (runs locally via Ollama)
OLLAMA_MODEL=qwen2.5vl:3b

# Text model used for outdoor quest generation (runs locally via Ollama; falls back to built-in quests if unavailable)
OLLAMA_QUEST_MODEL=qwen3:4b
